{
  "id": "channel_breakout_v1",
  "version": 1,
  "symbol": "TMF",
  "timeframe": "5m",
  "session": "day_and_night",
  "indicators": {
    "hh20": {"type": "HIGHEST", "source": "high", "length": 20},
    "ll20": {"type": "LOWEST", "source": "low", "length": 20},
    "fast_ma": {"type": "SMA", "source": "close", "length": 5},
    "slow_ma": {"type": "SMA", "source": "close", "length": 20}
  },
  "entry_long": {
    "cross_above": ["close", "hh20"]
  },
  "entry_short": {
    "cross_below": ["close", "ll20"]
  },
  "exit": {
    "stop_loss": {"type": "fixed_points", "value": 40},
    "take_profit": {"type": "fixed_points", "value": 120},
    "trailing_stop": {"type": "points", "value": 50, "activation_points": 50},
    "time_exit": {"before_settlement": true, "minutes_before_close": 15}
  },
  "execution": {
    "signal_on": "bar_close",
    "fill_at": "next_bar_open",
    "order_type": "range_market",
    "slippage_points": 1
  },
  "position_sizing": {"type": "fixed", "contracts": 1}
}
