{
  "id": "ma_rsi_filter_v1",
  "version": 1,
  "symbol": "TMF",
  "timeframe": "5m",
  "session": "day_and_night",
  "indicators": {
    "fast_ma": {"type": "EMA", "source": "close", "length": 5},
    "slow_ma": {"type": "EMA", "source": "close", "length": 20},
    "rsi14": {"type": "RSI", "source": "close", "length": 14}
  },
  "entry_long": {
    "all": [
      {"cross_above": ["fast_ma", "slow_ma"]},
      {"gt": ["rsi14", 50]}
    ]
  },
  "entry_short": {
    "all": [
      {"cross_below": ["fast_ma", "slow_ma"]},
      {"lt": ["rsi14", 50]}
    ]
  },
  "exit": {
    "stop_loss": {"type": "fixed_points", "value": 45},
    "take_profit": {"type": "fixed_points", "value": 110},
    "trailing_stop": null,
    "time_exit": {"before_settlement": true, "minutes_before_close": 15}
  },
  "execution": {
    "signal_on": "bar_close",
    "fill_at": "next_bar_open",
    "order_type": "range_market",
    "slippage_points": 1
  },
  "position_sizing": {"type": "fixed", "contracts": 1}
}
